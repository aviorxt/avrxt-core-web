{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "core-web-newsletter-unsubscribe",
  "main": "worker.ts",
  "compatibility_date": "2026-08-19",
  "workers_dev": false,
  "routes": [
    { "pattern": "unsub.example.com", "custom_domain": true }
  ],
  "ratelimits": [
    {
      "name": "REQUEST_LIMITER",
      "namespace_id": "replace-with-request-limit-namespace-id",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "UNSUBSCRIBE_LIMITER",
      "namespace_id": "replace-with-unsubscribe-limit-namespace-id",
      "simple": { "limit": 8, "period": 60 }
    }
  ],
  "secrets": {
    "required": ["SUPABASE_URL", "SUPABASE_SERVICE_ROLE_KEY", "RESEND_API_KEY"]
  }
}
